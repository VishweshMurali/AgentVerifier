*.sqlite
*.sqlite-journal

# Local multi-agent coordination notes: never uploaded
COORDINATION.md

# Generated output: LLM cache (raw prompts and replies) and verdicts/reports, local only
/cache/
/results/

# Phase D dress rehearsals on DEV: local only, never a verdict
results/rehearsal/

# Raw datasets for local scenarios: they hold TEST cases too, so never committed
sources/

# Per-scenario rehearsals
results/*/rehearsal/
