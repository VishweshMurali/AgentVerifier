# Copy to .env on the VM (cp .env.example .env; chmod 600 .env) and fill in by hand there.
# Never commit the real .env.
SITE_ADDRESS=:80
VERIFIER_PUBLIC=1
AGENT_PROVIDER=groq
GROQ_PROXY_URL=https://agent-verifier-groq-proxy.vishweshmurali.workers.dev/v1
GROQ_PROXY_TOKEN=
# optional, once you have a domain name (no https://):
# VERIFIER_ALLOWED_HOSTS=yourname.duckdns.org
FALSE_ALARM_WORKERS=1
